-- Example te init.lua. Copy to $XDG_CONFIG_HOME/te/init.lua (or
-- ~/.config/te/init.lua) and edit -- it's loaded automatically at startup.
-- A missing file is fine (te just uses its built-in defaults); a script
-- error is echoed on the status line instead of stopping te from starting.

-- te.action(name) runs any named command from src/binding.h's COMMANDS
-- table, same as typing it at the leader prompt.
te.bind("g", "ctrl-shift", function()
    te.action("select-all")
end)

-- te.bind(key, mods, handler) also takes an existing command name directly,
-- as a shortcut for a one-line function. Note: this overrides a matching
-- built-in from src/binding.h if one exists at the same key/mods -- script
-- bindings are always checked first.
te.bind("t", "ctrl-shift", "toggle-wrap")

-- A Lua function handler can read/write the buffer directly: te.text() (the
-- whole buffer), te.cursor()/te.set_cursor(pos) (byte offset), and
-- te.insert(text) (inserts at the cursor -- or replaces the selection --
-- through the same path as typing, so undo/redo just work).
te.bind("d", "ctrl-shift", function()
    te.insert(os.date("%Y-%m-%d"))
end)

-- te.text() lets a script inspect the buffer before deciding what to do --
-- here, warn instead of inserting past a size limit.
te.bind("y", "ctrl-shift", function()
    if #te.text() > 100000 then
        te.echo("buffer is getting big")
    else
        te.action("save")
    end
end)

-- te.bind_leader(key, mods, handler) is the same idea for leader chords
-- (leader = double-tap Ctrl, per the README): "leader d" inserts today's date.
te.bind_leader("d", "any", function()
    te.insert(os.date("%Y-%m-%d"))
end)

te.echo("init.lua loaded")
